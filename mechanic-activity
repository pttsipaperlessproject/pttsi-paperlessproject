<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mechanic Activity - PT TSI</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700;800&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/lucide@latest"></script>

    <style>
        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
            min-height: 100vh;
            color: #1e293b;
        }

        .color-primary { background-color: #1E3A8A; }
        .text-primary { color: #1E3A8A; }

        .glass-panel {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

        .logo-wrapper {
            transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        .logo-wrapper:hover {
            transform: scale(1.08) rotate(2deg);
        }

        .logo-shadow {
            filter:
                drop-shadow(0 10px 8px rgba(0, 0, 0, 0.04))
                drop-shadow(0 4px 3px rgba(0, 0, 0, 0.1));
        }

        .fade-in {
            animation: fadeIn 0.5s cubic-bezier(0.4, 0, 0.2, 1);
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(12px); }
            to { opacity: 1; transform: translateY(0); }
        }

        #toast {
            visibility: hidden;
            min-width: 300px;
            max-width: calc(100vw - 32px);
            background-color: #1e293b;
            color: #fff;
            text-align: center;
            border-radius: 12px;
            padding: 16px;
            position: fixed;
            z-index: 100;
            left: 50%;
            bottom: 30px;
            transform: translateX(-50%);
            box-shadow: 0 10px 25px rgba(0,0,0,0.2);
            border: 1px solid #334155;
        }

        #toast.show {
            visibility: visible;
            animation: fadein_toast 0.5s, fadeout_toast 0.5s 2.5s;
        }

        @keyframes fadein_toast {
            from { bottom: 0; opacity: 0; }
            to { bottom: 30px; opacity: 1; }
        }

        @keyframes fadeout_toast {
            from { bottom: 30px; opacity: 1; }
            to { bottom: 0; opacity: 0; }
        }

        @media (max-width: 640px) {
            .glass-panel { padding: 1.5rem !important; }
            #toast { min-width: 0; width: calc(100vw - 32px); }
        }

        /* Membuat multiple select lebih nyaman digunakan */
        select[multiple] {
            min-height: 150px;
        }

        select[multiple] option {
            padding: 10px 12px;
        }

        select[multiple] option:checked {
            background: #1E3A8A linear-gradient(0deg, #1E3A8A, #1E3A8A);
            color: white;
        }
    </style>
</head>

<body class="flex flex-col items-center p-4 sm:p-8">

<main class="w-full max-w-3xl flex-grow glass-panel p-6 sm:p-10 rounded-3xl shadow-2xl fade-in">

    <!-- HEADER -->
    <header class="w-full mb-8 pb-6 border-b-2 border-slate-100 flex flex-col items-center">

        <div class="mb-4 logo-wrapper">
            <div class="w-24 h-24 flex items-center justify-center bg-white rounded-2xl logo-shadow overflow-hidden p-2">
                <img
                    src="default_logo.png"
                    alt="Logo PT TSI"
                    class="w-full h-full object-contain"
                    id="companyLogo"
                    onerror="handleLogoError()"
                >

                <div
                    id="logoFallback"
                    class="hidden flex-col items-center justify-center bg-blue-900 w-full h-full text-white"
                >
                    <span class="font-black text-2xl">TSI</span>
                </div>
            </div>
        </div>

        <div class="color-primary text-white px-6 sm:px-8 py-4 rounded-2xl shadow-lg flex flex-col items-center gap-1">
            <h1 class="text-lg sm:text-2xl font-black uppercase tracking-[0.1em] text-center">
                MECHANIC ACTIVITY
            </h1>

            <div class="h-0.5 w-16 bg-amber-500 rounded-full my-1"></div>

            <h2 class="text-xs sm:text-base font-bold uppercase tracking-widest text-blue-100 text-center">
                PT TATSUMI SERUNI INDONESIA
            </h2>
        </div>

        <div class="mt-3 text-[10px] font-bold text-slate-400 tracking-[0.3em] uppercase text-center">
            Daily Workshop Activity
        </div>
    </header>


    <!-- INTRO -->
    <div class="mb-6 p-5 rounded-2xl bg-blue-50 border border-blue-100 shadow-sm">
        <div class="flex items-start gap-3">

            <div class="bg-blue-800 p-2.5 rounded-xl text-white shrink-0">
                <i data-lucide="clipboard-pen" class="w-5 h-5"></i>
            </div>

            <div>
                <h4 class="font-bold text-blue-900 text-sm uppercase tracking-wide">
                    Daily Mechanic Activity
                </h4>

                <p class="text-blue-800 text-xs mt-1 leading-relaxed">
                    Input aktivitas pekerjaan mechanic harian secara langsung
                    ke dalam sistem Workshop.
                </p>
            </div>

        </div>
    </div>


    <!-- FORM -->
    <form id="mechanicActivityForm" class="space-y-5">

        <!-- DATE -->
        <div>
            <label class="block text-sm font-bold text-slate-700 mb-2">
                Date
            </label>

            <input
                type="date"
                id="activityDate"
                required
                class="w-full p-4 bg-slate-50 border-2 border-slate-200 rounded-2xl font-semibold focus:border-blue-700 focus:ring-2 focus:ring-blue-100 outline-none transition"
            >
        </div>


        <!-- UNIT -->
        <div>
            <label class="block text-sm font-bold text-slate-700 mb-2">
                Unit
            </label>

            <select
                id="activityUnit"
                required
                class="w-full p-4 bg-slate-50 border-2 border-slate-200 rounded-2xl font-semibold focus:border-blue-700 focus:ring-2 focus:ring-blue-100 outline-none transition"
            >
                <option value="">Memuat unit...</option>
            </select>
        </div>


        <!-- PREVENTIVE -->
        <div>
            <label class="block text-sm font-bold text-slate-700 mb-2">
                Preventive
            </label>

            <select
                id="activityPreventive"
                multiple
                size="5"
                class="w-full p-4 bg-slate-50 border-2 border-slate-200 rounded-2xl font-semibold focus:border-blue-700 focus:ring-2 focus:ring-blue-100 outline-none transition"
            >
                <option value="">Memuat data...</option>
            </select>

            <p class="text-[10px] text-slate-400 mt-2 italic">
                Pilih satu atau beberapa preventive. Tidak wajib diisi.
            </p>
        </div>


        <!-- TROUBLE -->
        <div>
            <label class="block text-sm font-bold text-slate-700 mb-2">
                Trouble
            </label>

            <textarea
                id="activityTrouble"
                rows="3"
                placeholder="Masukkan trouble / pekerjaan..."
                class="w-full p-4 bg-slate-50 border-2 border-slate-200 rounded-2xl font-semibold focus:border-blue-700 focus:ring-2 focus:ring-blue-100 outline-none transition resize-none"
            ></textarea>
        </div>


        <!-- REMARK -->
        <div>
            <label class="block text-sm font-bold text-slate-700 mb-2">
                Remark
            </label>

            <select
                id="activityRemark"
                required
                class="w-full p-4 bg-slate-50 border-2 border-slate-200 rounded-2xl font-semibold focus:border-blue-700 focus:ring-2 focus:ring-blue-100 outline-none transition"
            >
                <option value="">Memuat data...</option>
            </select>
        </div>


        <!-- REPAIRED BY -->
        <div>
            <label class="block text-sm font-bold text-slate-700 mb-2">
                Repaired By
            </label>

            <select
                id="activityRepairedBy"
                multiple
                size="5"
                class="w-full p-4 bg-slate-50 border-2 border-slate-200 rounded-2xl font-semibold focus:border-blue-700 focus:ring-2 focus:ring-blue-100 outline-none transition"
            >
                <option value="">Memuat mechanic...</option>
            </select>

            <p class="text-[10px] text-slate-400 mt-2 italic">
                Pilih satu atau beberapa mechanic. Tidak wajib diisi.
            </p>
        </div>


        <!-- SHIFT -->
        <div>
            <label class="block text-sm font-bold text-slate-700 mb-2">
                Shift
            </label>

            <select
                id="activityShift"
                required
                class="w-full p-4 bg-slate-50 border-2 border-slate-200 rounded-2xl font-semibold focus:border-blue-700 focus:ring-2 focus:ring-blue-100 outline-none transition"
            >
                <option value="">Pilih Shift</option>
                <option value="1">Shift 1</option>
                <option value="2">Shift 2</option>
                <option value="3">Shift 3</option>
            </select>
        </div>


        <!-- STATUS LOTO -->
        <div>
            <label class="block text-sm font-bold text-slate-700 mb-2">
                Status LOTO
            </label>

            <select
                id="activityLoto"
                required
                class="w-full p-4 bg-slate-50 border-2 border-slate-200 rounded-2xl font-semibold focus:border-blue-700 focus:ring-2 focus:ring-blue-100 outline-none transition"
            >
                <option value="">Memuat status...</option>
            </select>
        </div>


        <!-- SUBMIT -->
        <button
            type="submit"
            id="submitActivityBtn"
            class="w-full bg-blue-800 hover:bg-blue-700 text-white font-black py-4 px-6 rounded-2xl shadow-xl border-b-8 border-blue-950 active:scale-[0.98] transition-all flex items-center justify-center gap-3"
        >
            <i data-lucide="send" class="w-5 h-5"></i>
            SUBMIT ACTIVITY
        </button>

    </form>

</main>


<footer class="mt-8 text-center text-slate-400 px-4 pb-8">
    <p class="font-bold text-slate-500 tracking-tight uppercase">
        &copy; 2026 Paperless Project - PT TSI. All rights reserved.
    </p>

    <p class="text-[10px] mt-1">
        System Architecture by:
        <span class="text-slate-600 font-semibold uppercase">
            Imam Wahyu Ramadhan, S.T.
        </span>
        |
        <span class="text-amber-600 font-bold uppercase tracking-tighter">
            Project 2.0
        </span>
    </p>
</footer>


<!-- TOAST -->
<div id="toast" class="flex items-center gap-3">
    <i data-lucide="info" class="text-amber-400 w-5 h-5"></i>
    <span id="toastMsg"></span>
</div>


<script>

    // =========================================================
    // CONFIGURATION
    // =========================================================

    const API_URL =
        'https://script.google.com/macros/s/AKfycbxUfR_ARS5-U9Od_GcEr25a9Xr8et-VVgtdWqgLVGw5WO7ZmVMbj_Y4IImPusvrzTtxYg/exec';


    // =========================================================
    // LOGO
    // =========================================================

    function handleLogoError() {

        const logo = document.getElementById('companyLogo');
        const fallback = document.getElementById('logoFallback');

        if (logo) {
            logo.classList.add('hidden');
        }

        if (fallback) {
            fallback.classList.remove('hidden');
            fallback.classList.add('flex');
        }
    }


    // =========================================================
    // DATE
    // =========================================================

    function setTodayDate() {

        const dateInput =
            document.getElementById('activityDate');

        if (!dateInput) return;

        const today = new Date();

        const localDate = new Date(
            today.getTime() -
            today.getTimezoneOffset() * 60000
        )
        .toISOString()
        .split('T')[0];

        dateInput.value = localDate;
    }


    // =========================================================
    // TOAST
    // =========================================================

    function showToast(message) {

        const toast =
            document.getElementById('toast');

        const toastMsg =
            document.getElementById('toastMsg');

        if (!toast || !toastMsg) return;

        toastMsg.innerText = message;

        toast.classList.remove('show');

        // Trigger animation restart
        void toast.offsetWidth;

        toast.classList.add('show');

        setTimeout(() => {
            toast.classList.remove('show');
        }, 3000);
    }


    // =========================================================
    // GET SELECTED MULTIPLE VALUES
    // =========================================================

    function getSelectedValues(selectId) {

        const select =
            document.getElementById(selectId);

        if (!select) return [];

        return Array.from(select.selectedOptions)
            .map(option => option.value)
            .filter(value => value !== '');
    }


    // =========================================================
    // LOAD MASTER DATA
    // =========================================================

    async function loadMechanicMasterData() {

        const unitSelect =
            document.getElementById('activityUnit');

        const preventiveSelect =
            document.getElementById('activityPreventive');

        const remarkSelect =
            document.getElementById('activityRemark');

        const repairedBySelect =
            document.getElementById('activityRepairedBy');

        const lotoSelect =
            document.getElementById('activityLoto');


        try {

            // -------------------------
            // SAFETY CHECK
            // -------------------------

            if (
                !unitSelect ||
                !preventiveSelect ||
                !remarkSelect ||
                !repairedBySelect ||
                !lotoSelect
            ) {
                throw new Error(
                    'Elemen form tidak ditemukan.'
                );
            }


            // -------------------------
            // LOADING
            // -------------------------

            unitSelect.innerHTML =
                '<option value="">Memuat unit...</option>';

            preventiveSelect.innerHTML =
                '<option value="">Memuat data...</option>';

            remarkSelect.innerHTML =
                '<option value="">Memuat data...</option>';

            repairedBySelect.innerHTML =
                '<option value="">Memuat mechanic...</option>';

            lotoSelect.innerHTML =
                '<option value="">Memuat status...</option>';


            // -------------------------
            // FETCH
            // -------------------------

            const response =
                await fetch(
                    API_URL + '?action=master',
                    {
                        method: 'GET',
                        cache: 'no-store'
                    }
                );


            if (!response.ok) {
                throw new Error(
                    'HTTP Error ' +
                    response.status
                );
            }


            const data =
                await response.json();


            console.log(
                'MASTER DATA:',
                data
            );


            if (!data || !Array.isArray(data.units)) {
                throw new Error(
                    'Master data Unit tidak valid.'
                );
            }


            // =====================================================
            // UNIT
            // =====================================================

            unitSelect.innerHTML =
                '<option value="">Pilih Unit</option>';

            data.units.forEach(unit => {

                const option =
                    document.createElement('option');

                option.value = unit;
                option.textContent = unit;

                unitSelect.appendChild(option);

            });


            // =====================================================
            // PREVENTIVE
            // =====================================================

            preventiveSelect.innerHTML = '';

            const preventiveData =
                Array.isArray(data.preventive)
                    ? data.preventive
                    : [];

            preventiveData.forEach(item => {

                if (!item) return;

                const option =
                    document.createElement('option');

                option.value = item;
                option.textContent = item;

                preventiveSelect.appendChild(option);

            });


            // Placeholder untuk multiple select
            if (preventiveSelect.options.length === 0) {

                const option =
                    document.createElement('option');

                option.value = '';
                option.textContent =
                    'Tidak ada data preventive';

                preventiveSelect.appendChild(option);
            }


            // =====================================================
            // REMARK
            // =====================================================

            remarkSelect.innerHTML =
                '<option value="">Pilih Remark</option>';

            const remarkData =
                Array.isArray(data.remarks)
                    ? data.remarks
                    : [];

            remarkData.forEach(item => {

                if (!item) return;

                const option =
                    document.createElement('option');

                option.value = item;
                option.textContent = item;

                remarkSelect.appendChild(option);

            });


            // =====================================================
            // REPAIRED BY
            // =====================================================

            repairedBySelect.innerHTML = '';

            const mechanicData =
                Array.isArray(data.repairedBy)
                    ? data.repairedBy
                    : [];

            mechanicData.forEach(item => {

                if (!item) return;

                const option =
                    document.createElement('option');

                option.value = item;
                option.textContent = item;

                repairedBySelect.appendChild(option);

            });


            if (repairedBySelect.options.length === 0) {

                const option =
                    document.createElement('option');

                option.value = '';
                option.textContent =
                    'Tidak ada data mechanic';

                repairedBySelect.appendChild(option);
            }


            // =====================================================
            // LOTO
            // =====================================================

            lotoSelect.innerHTML =
                '<option value="">Pilih Status LOTO</option>';

            const lotoData =
                Array.isArray(data.loto)
                    ? data.loto
                    : [];

            lotoData.forEach(item => {

                if (!item) return;

                const option =
                    document.createElement('option');

                option.value = item;
                option.textContent = item;

                lotoSelect.appendChild(option);

            });


            console.log(
                'Master data berhasil dimuat.'
            );

        }


        catch (error) {

            console.error(
                'Gagal memuat master data:',
                error
            );


            if (unitSelect) {
                unitSelect.innerHTML =
                    '<option value="">Gagal memuat unit</option>';
            }

            if (preventiveSelect) {
                preventiveSelect.innerHTML =
                    '<option value="">Gagal memuat data</option>';
            }

            if (remarkSelect) {
                remarkSelect.innerHTML =
                    '<option value="">Gagal memuat data</option>';
            }

            if (repairedBySelect) {
                repairedBySelect.innerHTML =
                    '<option value="">Gagal memuat mechanic</option>';
            }

            if (lotoSelect) {
                lotoSelect.innerHTML =
                    '<option value="">Gagal memuat status</option>';
            }


            showToast(
                'Gagal mengambil master data dari server.'
            );
        }
    }


    // =========================================================
    // SUBMIT
    // =========================================================

    document
        .getElementById('mechanicActivityForm')
        .addEventListener(
            'submit',
            async function(e) {

                e.preventDefault();


                const submitBtn =
                    document.getElementById(
                        'submitActivityBtn'
                    );


                // -------------------------
                // AMBIL MULTIPLE VALUES
                // -------------------------

                const preventiveValues =
                    getSelectedValues(
                        'activityPreventive'
                    );

                const repairedByValues =
                    getSelectedValues(
                        'activityRepairedBy'
                    );


                // -------------------------
                // PAYLOAD
                // -------------------------

                const payload = {

                    action: 'submitActivity',

                    date:
                        document.getElementById(
                            'activityDate'
                        ).value,

                    unit:
                        document.getElementById(
                            'activityUnit'
                        ).value,

                    preventive:
                        preventiveValues.join(', '),

                    trouble:
                        document.getElementById(
                            'activityTrouble'
                        ).value,

                    remark:
                        document.getElementById(
                            'activityRemark'
                        ).value,

                    repairedBy:
                        repairedByValues.join(', '),

                    shift:
                        document.getElementById(
                            'activityShift'
                        ).value,

                    loto:
                        document.getElementById(
                            'activityLoto'
                        ).value
                };


                console.log(
                    'SUBMIT PAYLOAD:',
                    payload
                );


                // -------------------------
                // BASIC VALIDATION
                // -------------------------

                if (!payload.date) {
                    showToast(
                        'Date wajib diisi.'
                    );
                    return;
                }

                if (!payload.unit) {
                    showToast(
                        'Unit wajib dipilih.'
                    );
                    return;
                }

                if (!payload.shift) {
                    showToast(
                        'Shift wajib dipilih.'
                    );
                    return;
                }

                if (!payload.loto) {
                    showToast(
                        'Status LOTO wajib dipilih.'
                    );
                    return;
                }


                try {

                    submitBtn.disabled = true;

                    submitBtn.innerHTML = `
                        <i data-lucide="loader-2"
                           class="w-5 h-5 animate-spin"></i>
                        SUBMITTING...
                    `;

                    lucide.createIcons();


                    // -------------------------
                    // SEND TO GOOGLE APPS SCRIPT
                    // -------------------------

                    const response =
                        await fetch(
                            API_URL,
                            {
                                method: 'POST',
                                body: JSON.stringify(
                                    payload
                                )
                            }
                        );


                    if (!response.ok) {

                        throw new Error(
                            'HTTP Error ' +
                            response.status
                        );
                    }


                    const result =
                        await response.json();


                    console.log(
                        'SUBMIT RESPONSE:',
                        result
                    );


                    if (!result.success) {

                        throw new Error(
                            result.message ||
                            'Gagal menyimpan data.'
                        );
                    }


                    // -------------------------
                    // SUCCESS
                    // -------------------------

                    showToast(
                        'Activity berhasil disimpan.'
                    );


                    document
                        .getElementById(
                            'mechanicActivityForm'
                        )
                        .reset();


                    // Kembalikan tanggal ke hari ini
                    setTodayDate();


                    // Pastikan multiple select
                    // benar-benar kosong
                    const preventive =
                        document.getElementById(
                            'activityPreventive'
                        );

                    const repairedBy =
                        document.getElementById(
                            'activityRepairedBy'
                        );


                    if (preventive) {

                        Array.from(
                            preventive.options
                        ).forEach(option => {
                            option.selected = false;
                        });
                    }


                    if (repairedBy) {

                        Array.from(
                            repairedBy.options
                        ).forEach(option => {
                            option.selected = false;
                        });
                    }

                }


                catch (error) {

                    console.error(
                        'SUBMIT ERROR:',
                        error
                    );


                    showToast(
                        error.message ||
                        'Gagal menyimpan activity.'
                    );
                }


                finally {

                    submitBtn.disabled = false;

                    submitBtn.innerHTML = `
                        <i data-lucide="send"
                           class="w-5 h-5"></i>
                        SUBMIT ACTIVITY
                    `;

                    lucide.createIcons();
                }

            }
        );


    // =========================================================
    // INITIALIZE
    // =========================================================

    window.addEventListener(
        'load',
        async function() {

            lucide.createIcons();

            setTodayDate();

            await loadMechanicMasterData();

        }
    );

</script>

</body>
</html>
